# Path to the SQLite database file (created by `npm run db:migrate`).
DATABASE_PATH=data/cardsort.db

# The single admin account (REQUIREMENTS AUTH-01).
ADMIN_EMAIL=admin@example.com
# bcrypt hash; generate with: npm run hash-password -- 'your-password'
# The script prints a "b64:..." form, which avoids "$" being mangled by Next.js / Docker Compose.
ADMIN_PASSWORD_HASH=

# At least 32 random characters; used to encrypt the admin session cookie.
SESSION_SECRET=

# Public base URL used to build participant share links.
PUBLIC_BASE_URL=http://localhost:3000
